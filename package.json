{
  "name": "@intuitui-labs/form-builder-engine",
  "version": "0.2.0",
  "description": "Headless schema-driven form evaluation, validation, hydration, and analytics engine built on TanStack Form and Zod for React Native, Expo, and Web.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "import": "./dist/ports/index.js",
      "default": "./dist/ports/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js",
      "default": "./dist/validation/index.js"
    },
    "./hydration": {
      "types": "./dist/hydration/index.d.ts",
      "import": "./dist/hydration/index.js",
      "default": "./dist/hydration/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "default": "./dist/analytics/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "import": "./dist/codegen/index.js",
      "default": "./dist/codegen/index.js"
    },
    "./affordance": {
      "types": "./dist/affordance/index.d.ts",
      "import": "./dist/affordance/index.js",
      "default": "./dist/affordance/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "default": "./dist/adapters/index.js"
    },
    "./adapters/geo": {
      "types": "./dist/adapters/geo/index.d.ts",
      "import": "./dist/adapters/geo/index.js",
      "default": "./dist/adapters/geo/index.js"
    },
    "./adapters/effect": {
      "types": "./dist/adapters/effect/index.d.ts",
      "import": "./dist/adapters/effect/index.js",
      "default": "./dist/adapters/effect/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "default": "./dist/persistence/index.js"
    },
    "./focus": {
      "types": "./dist/focus/index.d.ts",
      "import": "./dist/focus/index.js",
      "default": "./dist/focus/index.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "import": "./dist/lint/index.js",
      "default": "./dist/lint/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    },
    "./assessment": {
      "types": "./dist/assessment/index.d.ts",
      "import": "./dist/assessment/index.js",
      "default": "./dist/assessment/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js",
      "default": "./dist/studio/index.js"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance/index.js",
      "default": "./dist/governance/index.js"
    },
    "./psychometrics": {
      "types": "./dist/psychometrics/index.d.ts",
      "import": "./dist/psychometrics/index.js",
      "default": "./dist/psychometrics/index.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "import": "./dist/qr/index.js",
      "default": "./dist/qr/index.js"
    },
    "./manager": {
      "types": "./dist/manager/index.d.ts",
      "import": "./dist/manager/index.js",
      "default": "./dist/manager/index.js"
    },
    "./*": {

      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit",
    "check-types:tsgo": "tsgo --noEmit",
    "test": "vitest run --pool=threads",
    "test:coverage": "vitest run --pool=threads --coverage",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('node_modules',{recursive:true,force:true})\"",
    "clean:fixtures": "node scripts/run-matrix-test.mjs --clean",
    "test:matrix": "node scripts/run-matrix-test.mjs --all",
    "test:matrix:57": "node scripts/run-matrix-test.mjs --target=57",
    "test:matrix:58": "node scripts/run-matrix-test.mjs --target=58",
    "expo:latest": "pnpm --filter @intuitui-labs/showcase-latest run start",
    "expo:latest:go": "pnpm --filter @intuitui-labs/showcase-latest run start:go",
    "expo:latest:tunnel": "pnpm --filter @intuitui-labs/showcase-latest run start:tunnel",
    "expo:latest:web": "pnpm --filter @intuitui-labs/showcase-latest run web",
    "expo:next": "pnpm --filter @intuitui-labs/showcase-next run start",
    "expo:next:dev": "pnpm --filter @intuitui-labs/showcase-next run start:dev",
    "expo:next:web": "pnpm --filter @intuitui-labs/showcase-next run web",
    "expo:feedora": "pnpm --filter @intuitui-labs/feedora-showcase run start",
    "expo:feedora:go": "pnpm --filter @intuitui-labs/feedora-showcase run start:go",
    "expo:feedora:web": "pnpm --filter @intuitui-labs/feedora-showcase run web",
    "research:check": "pnpm --filter gihini-research run check",
    "research:dev": "pnpm --filter gihini-research run dev",
    "research:test": "pnpm --filter gihini-research run test",
    "expo:go": "pnpm run expo:latest:go",
    "expo:web": "pnpm run expo:latest:web",
    "showcase:verify": "pnpm --filter @intuitui-labs/showcase-latest run verify",
    "showcase:verify:next": "pnpm --filter @intuitui-labs/showcase-next run verify",
    "prepublishOnly": "pnpm run check-types && pnpm run test && pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intuitui-labs/form-builder.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "mobile",
    "form",
    "form-builder",
    "headless",
    "tanstack-form",
    "zod",
    "validation",
    "schema",
    "offline-first",
    "cross-platform",
    "hydration",
    "analytics"
  ],
  "author": "Intuitui Labs",
  "license": "MIT",
  "dependencies": {
    "@tanstack/form-core": "^0.42.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.3",
    "effect": "^4.0.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
